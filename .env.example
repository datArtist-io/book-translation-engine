# Copy to .env and fill in. Never commit .env.

# --- Model providers (at least one LLM key is required for real translation) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# Exact model ids. Check your provider console for the current ids.
BTE_DRAFTER=anthropic:claude-opus-5-5
BTE_JUDGE=gemini:gemini-2.5-pro
BTE_ALTERNATE=gemini:gemini-2.5-pro
BTE_NMT=google_translate

# Set to "mock" to run the whole pipeline offline with a deterministic fake engine.
# BTE_DRAFTER=mock
# BTE_JUDGE=mock
# BTE_ALTERNATE=mock

# --- Storage ---
BTE_DATA_DIR=./data
# SQLite by default; use postgresql+psycopg://user:pass@host/db for production
BTE_DATABASE_URL=

# --- Accuracy policy ---
# Major-error rate (per sentence) the release sample must stay under, at 95% confidence
BTE_TARGET_MAJOR_RATE=0.01
BTE_REFINE_PASSES=1
BTE_MAX_REPAIR_RUNGS=5

# --- Limits and cost control ---
BTE_MAX_UPLOAD_MB=100
BTE_JOB_TOKEN_BUDGET=20000000
BTE_PROVIDER_CONCURRENCY=4

# --- Web UI access (required when exposed beyond localhost) ---
BTE_ACCESS_TOKEN=
